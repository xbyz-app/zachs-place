---
import Icon from "./Icon.astro";

interface Props {
  id: string;
  entity: "live_nudes" | "lava_lamp";
  label: string;
  icon: string;
}
const { id, entity, label, icon } = Astro.props;
---
<button class="toggle-tile" data-tile={id} data-entity={entity} aria-pressed="false">
  <span class="icon"><Icon name={icon} size={28} /></span>
  <span class="label">{label}</span>
  <span class="dot" aria-hidden="true"></span>
</button>

<style>
  .toggle-tile {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--bg-tile);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-tile);
    color: var(--text-secondary);
    position: relative;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .toggle-tile .icon {
    color: var(--text-muted);
    transition: color 0.18s ease;
  }
  .toggle-tile .label {
    font-size: 14px;
    font-weight: 500;
  }
  .toggle-tile .dot {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-muted);
    transition: background 0.18s ease, box-shadow 0.18s ease;
  }
  .toggle-tile[aria-pressed="true"] {
    background: var(--bg-tile-active);
    border-color: var(--border-active);
    color: var(--text-primary);
    box-shadow: inset 0 0 0 1px var(--accent-warm-glow);
  }
  .toggle-tile[aria-pressed="true"] .icon { color: var(--accent-warm); }
  .toggle-tile[aria-pressed="true"] .dot {
    background: var(--accent-warm);
    box-shadow: 0 0 8px var(--accent-warm-glow);
  }
  .toggle-tile[data-offline="true"] {
    opacity: 0.45;
    pointer-events: none;
  }
</style>
