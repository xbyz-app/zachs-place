---
import Icon from "./Icon.astro";
// Living room lights. Wired by src/scripts/living.ts; deliberately not a
// [data-tile], so the office controls' offline state never dims it (and the
// reverse): the two read different endpoints.
---
<div class="living-tile" data-living data-offline="false">
  <header>
    <span class="icon"><Icon name="lightbulb" size={22} /></span>
    <span class="label">Living room lights</span>
  </header>
  <div class="levels" role="group" aria-label="Living room brightness">
    <button type="button" class="chip" data-living-action="low"    aria-pressed="false">Low</button>
    <button type="button" class="chip" data-living-action="normal" aria-pressed="false">Normal</button>
    <button type="button" class="chip" data-living-action="bright" aria-pressed="false">Bright</button>
  </div>
  <div class="moods" role="group" aria-label="Living room mood">
    <button type="button" class="chip" data-living-action="chill" aria-pressed="false">Chill</button>
    <button type="button" class="chip" data-living-action="off"   aria-pressed="false">Off</button>
  </div>
  <p class="hint">Bright and Low stay put until bedtime. Normal hands the lights back to the house.</p>
  <p class="offline" data-living-offline hidden>Living room lights are offline right now. Try again in a minute.</p>
</div>

<style>
  .living-tile {
    background: var(--bg-tile);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-tile);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: opacity 0.18s ease;
  }
  .living-tile[data-offline="true"] .levels,
  .living-tile[data-offline="true"] .moods { opacity: 0.45; pointer-events: none; }
  .living-tile header { display: flex; align-items: center; gap: var(--space-3); }
  .living-tile .icon { color: var(--text-muted); transition: color 0.18s ease; }
  .living-tile[data-on="true"] .icon { color: var(--accent-warm); }
  .living-tile .label { flex: 1; font-weight: 600; color: var(--text-primary); }
  .living-tile .levels { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); }
  .living-tile .moods  { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }
  .living-tile .chip {
    padding: var(--space-3) var(--space-2);
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-tile);
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 500;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .living-tile .chip[aria-pressed="true"] {
    background: var(--bg-tile-active);
    border-color: var(--border-active);
    color: var(--text-primary);
    box-shadow: inset 0 0 0 1px var(--accent-warm-glow);
  }
  .living-tile .chip[data-busy="true"] { opacity: 0.6; }
  .living-tile .hint, .living-tile .offline {
    margin: 0;
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
