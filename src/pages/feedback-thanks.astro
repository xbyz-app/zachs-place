---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Thanks — Zach's Place">
  <main class="page">
    <section class="hero">
      <h1>Got it — appreciate it.</h1>
      <p class="hero-sub">Zach will see it.</p>
    </section>
    <p class="back"><a href="/guest">← back to portal</a></p>
  </main>

  <style>
    .page {
      max-width: 480px;
      margin: 0 auto;
      padding: var(--space-6) var(--space-4) var(--space-10);
      color: var(--text-primary);
    }
    .hero {
      padding: var(--space-10) var(--space-4) var(--space-8);
      text-align: center;
      border-radius: var(--radius-card);
      background:
        radial-gradient(140% 100% at 50% 0%, rgba(232, 160, 92, 0.18) 0%, rgba(232, 160, 92, 0.04) 40%, transparent 70%),
        var(--bg-surface);
      border: 1px solid var(--border-subtle);
    }
    .hero h1 {
      margin: 0 0 var(--space-2);
      font-size: 28px;
      line-height: 1.2;
    }
    .hero-sub {
      margin: 0;
      color: var(--text-secondary);
      font-size: 15px;
    }
    .back {
      text-align: center;
      margin-top: var(--space-6);
      font-size: 13px;
    }
    .back a {
      color: var(--text-secondary);
    }
  </style>
</BaseLayout>
